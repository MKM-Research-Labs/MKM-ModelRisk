# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Virtualenv
.venv/

# Local environment
.env
.claude/settings.local.json

# OS
.DS_Store

# Local runtime / generated artifacts (uploads, audit report PDFs, native pg helper)
.pgdata*/
uploads/
pgctl.sh

# Internal planning notes. docs/project/ was deliberately scrubbed from the repo
# for the handover (see "remove internal planning docs and third-party
# references"), so planning stays local and is never committed.
*.local.md

# Local-only reference material (e.g. source templates) — kept on the machine but
# never committed to the handover repo. Outside every first-party dir so the
# licence-notice audit does not scan it either.
local/

# Bibliography / reference PDFs — large third-party documents kept locally and
# uploaded into the app's Documents store, never committed (both case variants,
# as macOS is case-insensitive but git patterns are not).
docs/bib/
docs/Bib/

# Large local binaries under docs/. The written material is tracked; the heavy
# artefacts beside it are not. Same reasoning as docs/bib/ above -- a third-party
# textbook or a 9 MB built PDF is kept on the machine, never in the repo.
docs/sklearn/*.pdf
docs/space-economy/
docs/*.docx
