# Copy to .env for local development. NEVER commit a real .env.
# config/env.py loads this file at import, so every entry point — python model.py,
# a WSGI server, the start scripts, pytest — sees the same settings. A real
# environment variable always wins over anything set here.

# --- Owner role: owns the schema, runs migrations, may TRUNCATE in tests ---
DB_OWNER_USER=mkm_owner
DB_OWNER_PASSWORD=mkm_dev_pw

# --- Application role: runtime access. INSERT/SELECT on the event log only;
#     UPDATE/DELETE are revoked at the database-grant level (immutability). ---
DB_APP_USER=mkm_app
DB_APP_PASSWORD=mkm_app_dev_pw

# --- Connection ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=mkm_modelrisk

# --- Where state lives. Both default to inside the clone; point them at an
#     external volume to keep the working copy free of data. Quote a path that
#     contains spaces. ---
# PG_DATA_DIR="./.pgdata"
# UPLOAD_DIR="./uploads"

# --- Root of the producing repository a migration reads from. Defaults to a
#     sibling of this clone. ---
# PRODUCER_ROOT="../PhysicalRisk"
