# Copy to .env for local development. NEVER commit a real .env.
# These values match scripts/pg.sh for a local native PostgreSQL cluster on 5433.

# --- Owner role: owns the schema, runs migrations, may TRUNCATE in tests ---
MKM_DB_OWNER_USER=mkm_owner
MKM_DB_OWNER_PASSWORD=mkm_dev_pw

# --- Application role: runtime access. INSERT/SELECT on the event log only;
#     UPDATE/DELETE are revoked at the database-grant level (immutability). ---
MKM_DB_APP_USER=mkm_app
MKM_DB_APP_PASSWORD=mkm_app_dev_pw

# --- Connection ---
MKM_DB_HOST=localhost
MKM_DB_PORT=5433
MKM_DB_NAME=mkm_modelrisk

# --- Cluster data directory (read by scripts/pg.sh) ---
# Where the native PostgreSQL cluster stores its files. Defaults to ./.pgdata.
# Quote the value if the path contains spaces.
# MKM_PG_DATA_DIR=./.pgdata
