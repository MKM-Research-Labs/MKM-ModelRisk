{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "modelrisk",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "gunicorn",
        "--config",
        "gunicorn.conf.py",
        "wsgi:application"
      ],
      "port": 5015,
      "autoPort": false
    },
    {
      "name": "modelrisk-verify",
      "port": 5016,
      "autoPort": false,
      "url": "http://127.0.0.1:5016"
    }
  ]
}
