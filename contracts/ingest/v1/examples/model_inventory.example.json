    {
      "model_id": "MKM-SG-001",
      "name": "Storm-Gauge Response Model",
      "short_name": "Storm-Gauge",
      "description": "Spatial decay model mapping storm intensity to gauge-level water levels. Uses distance-based attenuation with catchment-specific calibration.",
      "category": "Hazard",
      "tier": 2,
      "materiality": "Medium",
      "complexity": "Medium",
      "tier_rationale": "Medium materiality: translates storm events to local water levels for downstream GEV fitting. Medium complexity: spatial interpolation with calibrated decay parameters.",
      "status": "Active",
      "lifecycle_stage": "Development",
      "version": "1.0.0",
      "owner": "David K Kelly",
      "model_owner_role": "Chief Science Officer",
      "peer_reviewer": "TBD",
      "source_module": "src/models/stormgauge/forward_model.py",
      "methodology": "Spatial decay with distance-based intensity-to-level conversion",
      "alternatives_considered": [
        "Pure IDW interpolation",
        "Kriging",
        "Neural network spatial model"
      ],
      "methodology_rationale": "Physical decay model is interpretable and auditable. Kriging requires more data points than typically available. Neural networks lack transparency for regulatory purposes.",
      "assumptions": [
        {
          "id": "SG-A1",
          "description": "No antecedent moisture conditions modelled",
          "impact": "High",
          "monitoring": "Compare predicted vs observed for wet/dry antecedent periods",
          "mitigation": "Seasonal adjustment factor"
        },
        {
          "id": "SG-A2",
          "description": "Linear storm track interpolation",
          "impact": "Medium",
          "monitoring": "Track reconstruction error analysis",
          "mitigation": "Higher-order interpolation if needed"
        },
        {
          "id": "SG-A3",
          "description": "Static decay parameters",
          "impact": "Medium",
          "monitoring": "Parameter stability across seasons",
          "mitigation": "Seasonal recalibration"
        },
        {
          "id": "SG-A4",
          "description": "No tidal interaction",
          "impact": "High",
          "monitoring": "Residual analysis for coastal gauges",
          "mitigation": "Tidal correction for estuarine gauges"
        }
      ],
      "limitations": [
        {
          "id": "SG-L1",
          "description": "No antecedent conditions modelling",
          "impact": "High",
          "monitoring_trigger": "Systematic under-prediction after prolonged wet periods",
          "compensating_control": "Seasonal moisture index adjustment"
        },
        {
          "id": "SG-L2",
          "description": "Linear track interpolation may miss curved storm paths",
          "impact": "Medium",
          "monitoring_trigger": "Track error > 10km at gauge locations",
          "compensating_control": "Manual track review for significant events"
        },
        {
          "id": "SG-L3",
          "description": "Static sensitivity parameters",
          "impact": "Medium",
          "monitoring_trigger": "Parameter drift > 15% over 12 months",
          "compensating_control": "Annual recalibration"
        },
        {
          "id": "SG-L4",
          "description": "No tidal interaction for coastal/estuarine gauges",
          "impact": "High",
          "monitoring_trigger": "Prediction bias at tidal gauges",
          "compensating_control": "Exclude estuarine gauges or add tidal overlay"
        }
      ],
      "known_failure_modes": [
        "Gauges in urban areas with complex drainage may not follow spatial decay assumptions",
        "Flash flood events with very localised intensity poorly modelled by regional decay",
        "Snow-melt driven floods not captured by rainfall-only model"
      ],
      "key_parameters": [
        "decay_rate",
        "intensity_scale",
        "distance_exponent"
      ],
      "input_data": "Storm intensity distribution (MKM-SI-001), gauge locations, catchment geometry",
      "output_data": "Per-gauge water level responses for each storm scenario",
      "downstream_models": [
        "MKM-GH-001"
      ],
      "upstream_models": [
        "MKM-SI-001"
      ],
      "validation_status": "Initial",
      "validation_date": null,
