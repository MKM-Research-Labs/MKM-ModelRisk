    {
      "model_id": "MKM-GH-001",
      "name": "GEV Hazard Curve Model",
      "short_name": "GEV Hazard",
      "description": "Generalised Extreme Value distribution fitting for flood exceedance rates. Constructs hazard curves showing probability of exceeding given flood depths at each gauge location.",
      "category": "Hazard",
      "tier": 1,
      "materiality": "High",
      "complexity": "High",
      "tier_rationale": "High materiality: directly determines flood exceedance probabilities used in pricing and capital. High complexity: GEV fitting with shape parameter estimation, return level extrapolation, and term structure construction.",
      "status": "Active",
      "lifecycle_stage": "Development",
      "version": "1.0.0",
      "owner": "David K Kelly",
      "model_owner_role": "Chief Science Officer",
      "peer_reviewer": "TBD",
      "source_module": "src/models/hazard/gev.py",
      "methodology": "Maximum likelihood GEV fitting with exceedance rate scaling and return level term structure",
      "alternatives_considered": [
        "Peaks-over-threshold with GPD",
        "Empirical frequency analysis",
        "Log-Pearson Type III"
      ],
      "methodology_rationale": "GEV is the theoretically justified distribution for block maxima (annual maximum flood levels). GPD requires threshold selection; empirical methods cannot extrapolate; Log-Pearson less flexible shape.",
      "assumptions": [
        {
          "id": "GH-A1",
          "description": "Annual maxima are independent and identically distributed",
          "impact": "High",
          "monitoring": "Ljung-Box test on annual maxima series",
          "mitigation": "Time-varying GEV parameters"
        },
        {
          "id": "GH-A2",
          "description": "Stationarity over the observation period",
          "impact": "High",
          "monitoring": "Mann-Kendall trend test on annual maxima",
          "mitigation": "Non-stationary GEV extension"
        },
        {
          "id": "GH-A3",
          "description": "Univariate analysis per gauge (no spatial dependence)",
          "impact": "Medium",
          "monitoring": "Cross-gauge correlation analysis",
          "mitigation": "Max-stable process extension"
        },
        {
          "id": "GH-A4",
          "description": "Exceedance probability scaled by base flood rate",
          "impact": "High",
          "monitoring": "Base rate stability over time",
          "mitigation": "Recalibrate base rate annually"
        }
      ],
      "limitations": [
        {
          "id": "GH-L1",
          "description": "Sample size sensitivity: <30 annual maxima gives unstable shape parameter",
          "impact": "High",
          "monitoring_trigger": "Shape parameter confidence interval width > 0.3",
          "compensating_control": "Regional frequency analysis or Bayesian prior"
        },
        {
          "id": "GH-L2",
          "description": "Stationarity assumption may not hold under climate change",
          "impact": "High",
          "monitoring_trigger": "Significant trend (p<0.05) in annual maxima",
          "compensating_control": "Climate-adjusted return levels"
        },
        {
          "id": "GH-L3",
          "description": "Univariate analysis ignores spatial flood dependence",
          "impact": "Medium",
          "monitoring_trigger": "Correlated gauge failures in same event",
          "compensating_control": "Portfolio-level spatial diversification check"
        }
      ],
      "known_failure_modes": [
        "Very short records (<15 years) produce unreliable extreme quantiles",
        "Mixed flood generation mechanisms (pluvial + fluvial + tidal) violate iid assumption",
        "Shape parameter > 0.5 indicates heavy tail that may be physically unrealistic"
      ],
      "key_parameters": [
        "location (mu)",
        "scale (sigma)",
        "shape (xi)",
        "base_rate",
        "return_periods"
      ],
      "input_data": "Per-gauge water level time series (from MKM-SG-001 or historical observations)",
      "output_data": "Hazard curves (exceedance probability vs flood depth), return levels, term structure",
      "downstream_models": [
        "MKM-PR-001"
      ],
      "upstream_models": [
        "MKM-SG-001"
      ],
      "validation_status": "Initial",
      "validation_date": null,
