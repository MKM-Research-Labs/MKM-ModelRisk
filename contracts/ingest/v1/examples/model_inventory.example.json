    {
      "model_id": "MKM-SI-001",
      "name": "Storm Intensity Distribution",
      "short_name": "Storm Intensity",
      "description": "Hybrid Normal-Pareto distribution for storm rainfall intensity modelling. Uses Gaussian core with Generalised Pareto Distribution (GPD) tail above a fitted threshold.",
      "category": "Hazard",
      "tier": 2,
      "materiality": "Medium",
      "complexity": "Medium",
      "tier_rationale": "Medium materiality: feeds into downstream hazard models but not directly into pricing. Medium complexity: hybrid distribution with threshold selection requiring expert judgement.",
      "status": "Active",
      "lifecycle_stage": "Development",
      "version": "1.0.0",
      "owner": "David K Kelly",
      "model_owner_role": "Chief Science Officer",
      "peer_reviewer": "TBD",
      "source_module": "src/models/intensity/distribution.py",
      "methodology": "Hybrid Normal-GPD with maximum likelihood threshold estimation",
      "alternatives_considered": [
        "Pure Pareto",
        "Lognormal",
        "GPD only",
        "Pure GEV"
      ],
      "methodology_rationale": "Hybrid approach captures both typical and extreme rainfall. Pure Pareto overestimates body; lognormal underestimates tail. GPD-only misses the distribution body needed for moderate events.",
      "assumptions": [
        {
          "id": "SI-A1",
          "description": "Storm events are independent",
          "impact": "Medium",
          "monitoring": "Check autocorrelation in residuals",
          "mitigation": "Seasonal decomposition if violated"
        },
        {
          "id": "SI-A2",
          "description": "Stationarity of rainfall distribution",
          "impact": "High",
          "monitoring": "Rolling parameter stability test",
          "mitigation": "Climate trend adjustment"
        },
        {
          "id": "SI-A3",
          "description": "No spatial correlation between storm intensities",
          "impact": "Medium",
          "monitoring": "Cross-site correlation analysis",
          "mitigation": "Copula extension if needed"
        },
        {
          "id": "SI-A4",
          "description": "GPD threshold selection is appropriate",
          "impact": "High",
          "monitoring": "Mean residual life plot stability",
          "mitigation": "Sensitivity analysis on threshold"
        }
      ],
      "limitations": [
        {
          "id": "SI-L1",
          "description": "Independence assumption may not hold for clustered storm events",
          "impact": "Medium",
          "monitoring_trigger": "Autocorrelation > 0.3 at lag 1",
          "compensating_control": "Manual review of clustered events"
        },
        {
          "id": "SI-L2",
          "description": "Stationarity assumption ignores climate change trends",
          "impact": "High",
          "monitoring_trigger": "Significant trend in 10-year rolling parameters",
          "compensating_control": "Annual recalibration with trend test"
        },
        {
          "id": "SI-L3",
          "description": "No spatial correlation modelled",
          "impact": "Medium",
          "monitoring_trigger": "Portfolio concentration in single catchment",
          "compensating_control": "Diversification requirement"
        },
        {
          "id": "SI-L4",
          "description": "Threshold selection involves subjective judgement",
          "impact": "Medium",
          "monitoring_trigger": "Threshold sensitivity > 10% on tail quantiles",
          "compensating_control": "Document threshold selection rationale"
        }
      ],
      "known_failure_modes": [
        "Very small sample sizes (<20 events) cause unstable GPD fit",
        "Bimodal rainfall distributions (convective + frontal) poorly captured by single hybrid",
        "Extreme extrapolation beyond observed data unreliable"
      ],
      "key_parameters": [
        "threshold",
        "gpd_shape (xi)",
        "gpd_scale (sigma)",
        "normal_mean",
        "normal_std"
      ],
      "input_data": "Historical rainfall observations (Environment Agency gauge network)",
      "output_data": "Storm intensity probability distribution, exceedance probabilities",
      "downstream_models": [
        "MKM-SG-001"
      ],
      "upstream_models": [],
      "validation_status": "Initial",
      "validation_date": null,
